library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity ejemplo10 is
    port(
        clk : in std_logic;
        Q : out std_logic_vector(3 downto 0)
    );
end ejemplo10;

architecture rtl of ejemplo10 is
    signal temp : unsigned(3 downto 0) := "0000";
begin

    process(clk)
    begin
        if rising_edge(clk) then
            temp <= temp + 1;
        end if;
    end process;

    Q <= std_logic_vector(temp);

end rtl;
