library ieee;
use ieee.std_logic_1164.all;

entity ejemplo03 is
    port(
        E : in std_logic_vector(3 downto 0);
        S : in std_logic_vector(1 downto 0);
        F : out std_logic
    );
end ejemplo03;

architecture rtl of ejemplo03 is
begin
    with S select
        F <= E(0) when "00",
             E(1) when "01",
             E(2) when "10",
             E(3) when others;
end rtl;
