library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity ejemplo08 is
    port(
        A, B : in std_logic_vector(3 downto 0);
        S : out std_logic_vector(3 downto 0)
    );
end ejemplo08;

architecture rtl of ejemplo08 is
begin
    S <= std_logic_vector(unsigned(A) + unsigned(B));
end rtl;
