library ieee;
use ieee.std_logic_1164.all;

entity ejemplo05 is
    port(
        I : in std_logic_vector(2 downto 0);
        EN : in std_logic;
        S : out std_logic_vector(7 downto 0)
    );
end ejemplo05;

architecture rtl of ejemplo05 is
    signal AUX : std_logic_vector(7 downto 0);
begin

    with I select
        AUX <= "00000001" when "000",
               "00000010" when "001",
               "00000100" when "010",
               "00001000" when "011",
               "00010000" when "100",
               "00100000" when "101",
               "01000000" when "110",
               "10000000" when others;

    S <= AUX when EN='1' else "00000000";

end rtl;
